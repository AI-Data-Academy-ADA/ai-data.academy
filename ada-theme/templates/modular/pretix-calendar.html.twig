{% do assets.addCss(page.header.css_url, { crossorigin: 'anonymous' }) %}
{% do assets.addJs(page.header.js_url, { loading: 'async', crossorigin: 'anonymous' }) %}

<section class="content section">
	<pretix-widget event="{{ page.header.event_url }}"></pretix-widget>
	<noscript>
		<div class="pretix-widget">
			<div class="pretix-widget-info-message">
				JavaScript ist in Ihrem Browser deaktiviert. Um unseren Ticketshop ohne JavaScript aufzurufen, klicken Sie bitte
				<a target="_blank" rel="noopener" href="{{ page.header.event_url }}">hier</a>.
			</div>
		</div>
	</noscript>
</section>
