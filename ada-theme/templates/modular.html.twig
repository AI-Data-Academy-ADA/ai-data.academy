{% extends 'partials/base.html.twig' %}

{% set default_map_css_url = 'https://unpkg.com/maplibre-gl@^5.24.0/dist/maplibre-gl.css' %}
{% set default_map_js_url = 'https://unpkg.com/maplibre-gl@^5.24.0/dist/maplibre-gl.js' %}

{% block stylesheets %}
	{{ parent() }}
	{% for module in page.collection() %}
		{% set module_template = module.template() ~ '.html.twig' %}
		{% set module_css = 'theme://css/' ~ module.template() ~ '.css' %}
		{% do assets.addCss(module_css) ~ compress %}

		{# Modules that require external dependencies #}
		{% if module_template == 'modular/pretix-calendar.html.twig' and module.header.css_url and module.header.js_url %}
			{% do assets.addCss(module.header.css_url, { crossorigin: 'anonymous' }) %}
		{% endif %}

		{% if module_template == 'modular/geojson-map.html.twig' %}
			{% do assets.addCss(module.header.map_css_url|default(default_map_css_url), { crossorigin: 'anonymous' }) %}
		{% endif %}
	{% endfor %}

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{% for module in page.collection() %}
		{% set module_name = module.template()|replace('modular/', '') %}
		{% set module_js = 'theme://js/' ~ module_name ~ '.js' %}
		{% do assets.addJs(module_js, { group: 'bottom' }) ~ compress %}

		{% set module_template = module.template() ~ '.html.twig' %}
		{# Modules that require external dependencies #}
		{% if module_template == 'modular/pretix-calendar.html.twig' and module.header.css_url and module.header.js_url %}
			{% do assets.addJs(module.header.js_url, { loading: 'async	', crossorigin: 'anonymous' }) %}
		{% endif %}

		{% if module_template == 'modular/geojson-map.html.twig' %}
			{% do assets.addJs(module.header.map_js_url|default(default_map_js_url), { crossorigin: 'anonymous' }) %}
		{% endif %}
	{% endfor %}
{% endblock %}


{% block content %}
	{% for module in page.collection() %}
		{% if module.modular and module.template != 'modular/footer' and  module.template != 'modular/ada' %}
			{{ module.content|raw }}
		{% endif %}
	{% endfor %}
{% endblock content %}

{% block footer_content %}
	{% set footer_modules = page.collection()|filter(module => module.template == 'modular/footer') %}

	{% for footer in footer_modules %}
		{{ footer.content|raw }}
	{% endfor %}

	{{parent()}}

	{% set ada_module = page.collection()|filter(module => module.template == 'modular/ada')|first %}
	{% if ada_module %}
		{{ ada_module.content|raw}}
	{% endif %}
{% endblock %}
